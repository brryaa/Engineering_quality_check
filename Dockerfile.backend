FROM python:3.12-slim

WORKDIR /app

ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1

COPY backend/requirements.txt /app/requirements.txt
RUN pip install --no-cache-dir -r /app/requirements.txt

COPY backend/ /app/

# Initialize and seed database if not exists, then start uvicorn
CMD ["sh", "-c", "python3 -m app.seeds.seed_data && python3 -m uvicorn app.main:app --host 0.0.0.0 --port 8088"]
